{
  "version": 2,
  "builds": [
    {
      "src": "public/index.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/public/index.php"
    }
  ],
  "env": {
    "APP_NAME": "Sisters Station",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https:sisters_station.vercel.app",
    "APP_KEY": "base64:YOUR_LARAVEL_APP_KEY_HERE"
  }
}